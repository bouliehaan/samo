{
    "name": "@samo/android",
    "version": "1.0.0",
    "private": true,
    "expo": {
        "autolinking": {
            "android": {
                "buildFromSource": [
                    "expo-blur"
                ]
            }
        }
    },
    "main": "index.ts",
    "scripts": {
        "android": "NODE_ENV=development JAVA_HOME=\"/Applications/Android Studio.app/Contents/jbr/Contents/Home\" expo run:android",
        "android:emu": "NODE_ENV=development JAVA_HOME=\"/Applications/Android Studio.app/Contents/jbr/Contents/Home\" expo run:android -- -PreactNativeArchitectures=x86_64",
        "android:build": "cd android && NODE_ENV=development JAVA_HOME=\"/Applications/Android Studio.app/Contents/jbr/Contents/Home\" ./gradlew app:assembleDebug -PreactNativeArchitectures=arm64-v8a -x lint -x test",
        "android:release": "cd android && JAVA_HOME=\"/Applications/Android Studio.app/Contents/jbr/Contents/Home\" ./gradlew app:assembleRelease -PreactNativeArchitectures=armeabi-v7a,arm64-v8a,x86,x86_64 -x lint -x test",
        "android:metro": "expo start --android",
        "ios": "expo run:ios",
        "start": "expo start --dev-client",
        "lint": "eslint --max-warnings=0 src",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "pnpm -C ../.. exec vitest run --config vitest.android.config.ts",
        "verify": "pnpm run typecheck && pnpm run lint",
        "web": "expo start --web"
    },
    "dependencies": {
        "@samo/core": "file:../../packages/core",
        "@shopify/flash-list": "2.0.2",
        "expo": "~54.0.33",
        "expo-blur": "~15.0.8",
        "expo-file-system": "~19.0.22",
        "expo-font": "~14.0.12",
        "expo-haptics": "~15.0.8",
        "expo-image": "~3.0.11",
        "expo-keep-awake": "~15.0.8",
        "expo-secure-store": "^15.0.8",
        "expo-sqlite": "~16.0.10",
        "expo-status-bar": "~3.0.9",
        "react": "19.1.0",
        "react-freeze": "^1.0.4",
        "react-native": "0.81.5",
        "react-native-gesture-handler": "~2.28.0",
        "react-native-image-colors": "2.6.0",
        "react-native-keyboard-controller": "^1.22.2",
        "react-native-linear-gradient": "^2.8.3",
        "react-native-reanimated": "~4.1.7",
        "react-native-safe-area-context": "~5.6.2",
        "react-native-svg": "15.12.1",
        "react-native-udp": "^4.1.7"
    },
    "devDependencies": {
        "@types/react": "~19.1.0",
        "typescript": "~5.9.2"
    }
}
