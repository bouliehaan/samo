{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "vite.react-plugin.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/i18n/**/*",
    "src/types/**/*",
    "src/shared/**/*",
    "packages/core/src/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "/@/main/*": [
        "src/main/*"
      ],
      "/@/preload/*": [
        "src/preload/*"
      ],
      "/@/shared/*": [
        "src/shared/*"
      ],
      "@samo/core": [
        "packages/core/src/index.ts"
      ],
      "@samo/core/*": [
        "packages/core/src/*"
      ],
    }
  }
}
