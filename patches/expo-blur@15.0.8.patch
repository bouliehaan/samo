index 0000000000000000000000000000000000000000..e8d091bf8201d8a42254eaf68284692b6b957dd1
--- /dev/null
+++ b/android/src/main/java/expo/modules/blur/SaturatingRenderEffectBlur.kt
@@ -0,0 +1,114 @@
+package expo.modules.blur
+
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.ColorMatrix
+import android.graphics.ColorMatrixColorFilter
+import android.graphics.RenderEffect
+import android.graphics.RenderNode
+import android.graphics.Shader
+import android.os.Build
+import androidx.annotation.RequiresApi
+import eightbitlab.com.blurview.BlurAlgorithm
+import eightbitlab.com.blurview.BlurController
+
+/**
+ * Twin of the library's RenderEffectBlur that chains a saturation
+ * ColorMatrix into the SAME RenderEffect as the blur, so the blurred
+ * backdrop can be chroma-boosted inside the blur's own pipeline.
+ *
+ * Why this exists: compositing saturation at the React layer
+ * (mixBlendMode overlays, filter-style wrappers) forces an offscreen
+ * layer around the BlurView, which breaks its snapshot draw — the blur
+ * renders at a fraction of the view with a hard edge, or not at all.
+ * The only reliable place for a color transform is the RenderNode the
+ * blur already renders through.
+ */
+@RequiresApi(Build.VERSION_CODES.S)
+class SaturatingRenderEffectBlur : BlurAlgorithm {
+  private val node = RenderNode("SaturatingBlurViewNode")
+  private var height = 0
+  private var width = 0
+  private var lastBlurRadius = 1f
+
+  var saturation: Float = 1f
+    set(value) {
+      if (field != value) {
+        field = value
+        if (width > 0 && height > 0) {
+          applyEffect(lastBlurRadius)
+        }
+      }
+    }
+
+  // Uniform RGB scale (1 = unchanged) folded into the same ColorMatrix as the
+  // saturation boost. A multiplicative dim inside the blur darkens the
+  // backdrop while PRESERVING its contrast and chroma ratios — unlike piling
+  // alpha onto the React-layer smoke tint, which veils the content it is
+  // supposed to show through. This is what lets the dock read as near-black
+  // smoked glass yet stay visibly alive when bright artwork moves beneath it.
+  var brightness: Float = 1f
+    set(value) {
+      if (field != value) {
+        field = value
+        if (width > 0 && height > 0) {
+          applyEffect(lastBlurRadius)
+        }
+      }
+    }
+
+  override fun blur(bitmap: Bitmap, blurRadius: Float): Bitmap {
+    lastBlurRadius = blurRadius
+    if (bitmap.height != height || bitmap.width != width) {
+      height = bitmap.height
+      width = bitmap.width
+      node.setPosition(0, 0, width, height)
+    }
+    val canvas = node.beginRecording()
+    canvas.drawBitmap(bitmap, 0f, 0f, null)
+    node.endRecording()
+    applyEffect(blurRadius)
+    // The bitmap itself stays unblurred; rendering happens via the RenderNode.
+    return bitmap
+  }
+
+  private fun applyEffect(blurRadius: Float) {
+    val blur = RenderEffect.createBlurEffect(blurRadius, blurRadius, Shader.TileMode.MIRROR)
+    val effect = if (saturation == 1f && brightness == 1f) {
+      blur
+    } else {
+      // One matrix for both: uniform scaling commutes with the saturation
+      // mix, so the order here is irrelevant.
+      val matrix = ColorMatrix().apply { setSaturation(saturation) }
+      if (brightness != 1f) {
+        matrix.postConcat(ColorMatrix().apply { setScale(brightness, brightness, brightness, 1f) })
+      }
+      RenderEffect.createChainEffect(
+        RenderEffect.createColorFilterEffect(ColorMatrixColorFilter(matrix)),
+        blur
+      )
+    }
+    node.setRenderEffect(effect)
+  }
+
+  override fun destroy() {
+    node.discardDisplayList()
+  }
+
+  override fun canModifyBitmap(): Boolean = true
+
+  override fun getSupportedBitmapConfig(): Bitmap.Config = Bitmap.Config.ARGB_8888
+
+  override fun scaleFactor(): Float = BlurController.DEFAULT_SCALE_FACTOR
+
+  override fun render(canvas: Canvas, bitmap: Bitmap) {
+    if (canvas.isHardwareAccelerated) {
+      canvas.drawRenderNode(node)
+    } else {
+      // The upstream class falls back to RenderScript here, but expo-blur
+      // never supplies the Context that fallback needs. Drawing the
+      // unblurred snapshot beats crashing on a software canvas.
+      canvas.drawBitmap(bitmap, 0f, 0f, null)
+    }
+  }
+}
