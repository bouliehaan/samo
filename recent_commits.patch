-const parsePath = (fullPath: string) => {
-    const [path, params] = fullPath.split('?');
-
-    const parsedParams = qs.parse(params);
-    const notNilParams = omitBy(parsedParams, (value) => value === 'undefined' || value === 'null');
-
-    return {
-        params: notNilParams,
-        path,
-    };
